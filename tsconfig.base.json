      "@sunfall/vesper-agent/workflow": ["./packages/agent/src/workflow.ts"],
      "@sunfall/vesper-log/vocabulary": ["./packages/log/src/vocabulary.ts"],
      "@sunfall/vesper-log/offset": ["./packages/log/src/offset.ts"],
      "@sunfall/vesper-log/record": ["./packages/log/src/record.ts"],
