        "./packages/agent/src/dynamic-toolkit.ts"
      ],
      "@sunfall/vesper-agent/event": ["./packages/agent/src/event.ts"],
      "@sunfall/vesper-agent/eval": ["./packages/agent/src/eval.ts"],
      "@sunfall/vesper-agent/history": ["./packages/agent/src/history.ts"],
      "@sunfall/vesper-agent/interception": [
        "./packages/agent/src/interception.ts"
      ],
      "@sunfall/vesper-agent/interaction": [
        "./packages/agent/src/interaction.ts"
      ],
      "@sunfall/vesper-agent/model-plan": [
        "./packages/agent/src/model-plan.ts"
      ],
      "@sunfall/vesper-agent/recording-policy": [
        "./packages/agent/src/recording-policy.ts"
