+
+/**
+ * Response part representing a tool call generated by the model which could
+ * not be resolved, because its parameters failed validation against the
+ * tool's parameter schema or because the tool is not in the toolkit.
+ *
+ * **Details**
+ *
+ * This part is only produced when the language model operation was run with
+ * `invalidToolCalls: "return"`. The original call is preserved so it can be added
+ * to the conversation history together with the error as a failed tool
+ * result, which allows the model to correct and retry the call. No tool
+ * handler is executed for a tool call error.
+ *
+ * **Example** (Inspecting a tool call error)
+ *
+ * ```ts import.meta.vitest
+ * import { AiError, Response } from "effect/unstable/ai"
+ *
+ * const part = Response.makePart("tool-call-error", {
+ *   id: "call_123",
+ *   name: "get_weather",
+ *   params: { city: 42 },
+ *   providerExecuted: false,
+ *   error: AiError.make({
+ *     module: "LanguageModel",
+ *     method: "generateText",
+ *     reason: new AiError.ToolParameterValidationError({
+ *       toolName: "get_weather",
+ *       toolParams: { city: 42 },
+ *       description: "Expected string, got 42"
+ *     })
+ *   })
+ * })
+ *
+ * const result = [part.name, part.error.reason._tag] // => ["get_weather", "ToolParameterValidationError"]
+ * ```
+ *
+ * @category models
+ * @since 4.0.0
+ */
+export interface ToolCallErrorPart<Name extends string = string>
+  extends BasePart<"tool-call-error", ToolCallPartMetadata>
+{
+  /**
+   * Unique identifier for this tool call.
+   */
+  readonly id: string
+  /**
+   * Name of the tool the model attempted to call.
+   */
+  readonly name: Name
+  /**
+   * The parameters generated by the model, as JSON.
+   */
+  readonly params: Schema.Json
+  /**
+   * The reason the tool call could not be resolved.
+   */
+  readonly error: AiError.AiError
+  /**
+   * Whether the tool was executed by the provider (true) or framework (false).
+   */
+  readonly providerExecuted: boolean
