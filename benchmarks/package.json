{
  "name": "@sunfall/vesper-benchmarks",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Timing and memory measurements for the Vesper agent loop and volatile conversation log.",
  "homepage": "https://github.com/sunfall-labs/vesper#readme",
  "bugs": {
    "url": "https://github.com/sunfall-labs/vesper/issues"
  },
  "license": "MIT",
  "author": "Andrew Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunfall-labs/vesper.git",
    "directory": "benchmarks"
  },
  "type": "module",
  "scripts": {
    "bench": "node --experimental-strip-types src/main.ts",
    "bench:compare:flue": "node --experimental-strip-types src/compare-flue.ts",
    "typecheck": "tsgo -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@flue/runtime": "2.0.3",
    "@sunfall/vesper-agent": "workspace:*",
    "@sunfall/vesper-log": "workspace:*",
    "effect": "4.0.0-rc.109",
    "valibot": "1.4.2"
  }
}
