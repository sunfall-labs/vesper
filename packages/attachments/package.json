{
  "name": "@sunfall/vesper-attachments",
  "version": "0.1.0-alpha.1",
  "description": "Content-addressed blob storage for agent conversations, verified on read.",
  "keywords": [
    "attachments",
    "content-addressed",
    "effect",
    "storage",
    "typescript"
  ],
  "homepage": "https://github.com/sunfall-labs/vesper#readme",
  "bugs": {
    "url": "https://github.com/sunfall-labs/vesper/issues"
  },
  "license": "MIT",
  "author": "Andrew Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunfall-labs/vesper.git",
    "directory": "packages/attachments"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    "./ref": {
      "types": "./dist/ref.d.ts",
      "default": "./dist/ref.js"
    },
    "./attachment-store": {
      "types": "./dist/attachment-store.d.ts",
      "default": "./dist/attachment-store.js"
    },
    "./layer-memory": {
      "types": "./dist/layer-memory.d.ts",
      "default": "./dist/layer-memory.js"
    },
    "./layer-filesystem": {
      "types": "./dist/layer-filesystem.d.ts",
      "default": "./dist/layer-filesystem.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --pretty false --noEmit"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "vitest": "^4.1.9"
  }
}
