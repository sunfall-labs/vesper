{
  "name": "@sunfall/vesper-log",
  "version": "0.1.0-alpha.1",
  "description": "An append-only conversation log with per-record offsets, producer fencing, tailing, and an in-memory adapter.",
  "keywords": [
    "append-only",
    "effect",
    "event-sourcing",
    "typescript"
  ],
  "homepage": "https://github.com/sunfall-labs/vesper#readme",
  "bugs": {
    "url": "https://github.com/sunfall-labs/vesper/issues"
  },
  "license": "MIT",
  "author": "Andrew Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunfall-labs/vesper.git",
    "directory": "packages/log"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    "./vocabulary": {
      "types": "./dist/vocabulary.d.ts",
      "default": "./dist/vocabulary.js"
    },
    "./offset": {
      "types": "./dist/offset.d.ts",
      "default": "./dist/offset.js"
    },
    "./record": {
      "types": "./dist/record.d.ts",
      "default": "./dist/record.js"
    },
    "./record-batch": {
      "types": "./dist/record-batch.d.ts",
      "default": "./dist/record-batch.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./log-store": {
      "types": "./dist/log-store.d.ts",
      "default": "./dist/log-store.js"
    },
    "./tail": {
      "types": "./dist/tail.d.ts",
      "default": "./dist/tail.js"
    },
    "./layer-memory": {
      "types": "./dist/layer-memory.d.ts",
      "default": "./dist/layer-memory.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --pretty false --noEmit"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "effect": "catalog:",
    "vitest": "^4.1.9"
  }
}
