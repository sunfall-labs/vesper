{
  "name": "@sunfall/vesper-log",
  "version": "0.1.0-alpha.1",
  "description": "An append-only conversation log with per-record offsets, producer fencing, tailing, and memory + Postgres backends.",
  "keywords": [
    "append-only",
    "effect",
    "event-sourcing",
    "postgres",
    "typescript"
  ],
  "homepage": "https://github.com/sunfall-labs/vesper#readme",
  "bugs": {
    "url": "https://github.com/sunfall-labs/vesper/issues"
  },
  "license": "MIT",
  "author": "Andrew Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunfall-labs/vesper.git",
    "directory": "packages/log"
  },
  "files": [
    "dist",
    "migrations",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    "./vocabulary": {
      "types": "./dist/vocabulary.d.ts",
      "default": "./dist/vocabulary.js"
    },
    "./offset": {
      "types": "./dist/offset.d.ts",
      "default": "./dist/offset.js"
    },
    "./record": {
      "types": "./dist/record.d.ts",
      "default": "./dist/record.js"
    },
    "./record-batch": {
      "types": "./dist/record-batch.d.ts",
      "default": "./dist/record-batch.js"
    },
    "./log-store": {
      "types": "./dist/log-store.d.ts",
      "default": "./dist/log-store.js"
    },
    "./tail": {
      "types": "./dist/tail.d.ts",
      "default": "./dist/tail.js"
    },
    "./layer-memory": {
      "types": "./dist/layer-memory.d.ts",
      "default": "./dist/layer-memory.js"
    },
    "./log-store-contract": {
      "types": "./dist/log-store-contract.d.ts",
      "default": "./dist/log-store-contract.js"
    },
    "./layer-pg": {
      "types": "./dist/layer-pg.d.ts",
      "default": "./dist/layer-pg.js"
    },
    "./pg-client": {
      "types": "./dist/pg-client.d.ts",
      "default": "./dist/pg-client.js"
    },
    "./migrations/001-initial.sql": "./migrations/001-initial.sql"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsgo -p tsconfig.json --pretty false --noEmit"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.109",
    "vitest": ">=4.1.9 <5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "effect": "catalog:",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/pg": "^8.20.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.0-rc.109",
    "pg": "8.20.0"
  }
}
