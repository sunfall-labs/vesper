{
  "name": "@sunfall/vesper-agent",
  "version": "0.1.0-alpha.1",
  "description": "The agent loop: dynamic tools, subagents, skills, interception, recording, and resumption.",
  "keywords": [
    "agent",
    "effect",
    "llm",
    "tool-calling",
    "typescript"
  ],
  "homepage": "https://github.com/sunfall-labs/vesper#readme",
