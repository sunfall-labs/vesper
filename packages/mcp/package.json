{
  "name": "@sunfall/vesper-mcp",
  "version": "0.1.0-alpha.1",
  "description": "Consume MCP servers as Effect-native Vesper toolkits.",
  "keywords": [
    "agent",
    "effect",
    "mcp",
    "model-context-protocol",
    "typescript"
  ],
  "homepage": "https://github.com/sunfall-labs/vesper#readme",
  "bugs": {
    "url": "https://github.com/sunfall-labs/vesper/issues"
  },
  "license": "MIT",
  "author": "Andrew Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunfall-labs/vesper.git",
    "directory": "packages/mcp"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    "./mcp": {
