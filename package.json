{
  "name": "sunfall-vesper-workspace",
  "private": true,
  "homepage": "https://github.com/sunfall-labs/vesper#readme",
  "bugs": {
    "url": "https://github.com/sunfall-labs/vesper/issues"
  },
  "license": "MIT",
  "author": "Andrew Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunfall-labs/vesper.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsdown && bun run check:published-types",
    "benchmark": "bun run --filter @sunfall/vesper-benchmarks bench",
    "example:approval-cli": "node --experimental-strip-types examples/approval-cli/src/main.ts",
    "example:compliance-relay": "bun run --filter @sunfall/vesper-example-compliance-relay start",
    "example:live-smoke": "bun run --filter @sunfall/vesper-example-live-smoke start",
    "example:support-agent": "bun run --filter @sunfall/vesper-example-support-agent start",
    "test": "vitest run",
    "test:runtime:bun": "bun run build && bun scripts/check-code-executor-runtime.mjs",
    "test:runtime:deno": "bun run build && deno run --no-config --no-prompt --unstable-byonm --node-modules-dir=manual --allow-env --allow-run=deno scripts/check-code-executor-runtime.mjs",
    "typecheck": "bun run check:package-paths && bun run check:unsafe-casts && bun run --filter './packages/*' --filter './examples/*' typecheck && bun run typecheck:types",
    "check:package-paths": "node scripts/check-package-paths.mjs",
    "check:packed-consumer": "node scripts/check-packed-consumer.mjs",
    "check:publish-ready": "node scripts/check-publish-ready.mjs",
    "audit:packed-consumer": "node scripts/check-packed-consumer.mjs --audit",
    "check:published-types": "node scripts/check-published-types.mjs && tsc -p tsconfig.published-types.json --noEmit --pretty false",
    "check:unsafe-casts": "node scripts/check-unsafe-casts.mjs",
    "typecheck:types": "tsc -p tsconfig.type-tests.json --noEmit --pretty false",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "knip": "knip",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "lint:prune": "oxlint . --prune-suppressions --no-error-on-unmatched-pattern && oxfmt oxlint-suppressions.json --write",
    "prepare": "effect-tsgo patch --oxlint",
    "publish:npm": "bun run check:publish-ready && bun scripts/publish-packages.mjs --tag alpha --provenance",
    "publish:npm:dry-run": "bun run check:publish-ready && bun scripts/publish-packages.mjs --tag alpha --dry-run",
    "verify": "bun run build && bun run check:packed-consumer && bun run verify:static && bun run test",
    "verify:serial": "bun run build && bun run check:packed-consumer && bun run verify:static --max-processes 1 && bun run test",
    "verify:static": "concurrently --group --timings --names format,lint,typecheck,knip \"bun run format:check\" \"bun run lint\" \"bun run typecheck\" \"bun run knip\""
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@effect/ai-anthropic": "catalog:",
    "@effect/ai-openai": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.36.5",
    "@effect/vitest": "catalog:",
    "@types/node": "^24.0.0",
    "concurrently": "10.0.5",
    "effect": "catalog:",
    "knip": "6.32.2",
    "oxc-parser": "0.143.0",
    "oxfmt": "0.55.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.4.3",
      "onFail": "ignore"
    }
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "benchmarks"
    ],
    "catalog": {
      "@effect/ai-anthropic": "4.0.3",
      "@effect/ai-openai": "4.0.3",
      "@effect/ai-openrouter": "4.0.3",
      "@effect/platform-node": "4.0.3",
      "@effect/vitest": "4.0.3",
      "effect": "4.0.3"
    }
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.3",
    "effect": "4.0.3"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "esbuild"
  ],
  "patchedDependencies": {
    "effect@4.0.3": "patches/effect@4.0.3.patch",
    "@effect/ai-anthropic@4.0.3": "patches/@effect%2Fai-anthropic@4.0.3.patch",
    "@effect/ai-openai@4.0.3": "patches/@effect%2Fai-openai@4.0.3.patch"
  }
}
